# ----------------------------------------------------------------------------
# Firebase (client SDK). Copy this file to `.env.local` and fill in the values
# from your Firebase project settings: Project settings > General > Your apps.
# These NEXT_PUBLIC_* values are exposed to the browser by design — protect data
# with Firebase Auth + Firestore Security Rules, not by hiding these.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ----------------------------------------------------------------------------
# Razorpay (payments). The publishable key id is safe for the browser; the
# secret must only ever live server-side (Route Handler / Server Action).
# ----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public site URL (used for absolute links / metadata in production).
# Must be the www host: the bare apex 308-redirects to www, so using the apex
# here makes every canonical tag and og:url point at a redirect.
NEXT_PUBLIC_SITE_URL=https://www.aankhondekha.com

# ----------------------------------------------------------------------------
# Google Ads conversion tracking (optional).
#
# GA4 purchase events are always sent and need no configuration here. These two
# additionally report the sale to Google Ads, which is what makes cost per
# acquisition and return on ad spend reportable against a campaign.
#
# Both must be set for anything to fire. Google Ads > Tools > Conversions >
# your "Purchase" action > Tag setup.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_PURCHASE_LABEL=
